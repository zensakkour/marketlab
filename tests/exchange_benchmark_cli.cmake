function(check_sample)
    execute_process(COMMAND "${BENCHMARK}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Benchmark failed (${ARGN}): ${status} ${diagnostic}")
    endif()
    string(JSON checks GET "${output}" checks_passed)
    string(JSON method GET "${output}" memory method)
    string(JSON memory_type TYPE "${output}" memory peak_resident_bytes)
    if(NOT checks OR NOT method STREQUAL MEMORY_METHOD)
        message(FATAL_ERROR "Missing checks or unexpected memory method: ${output}")
    endif()
    if(MEMORY_METHOD STREQUAL "unavailable")
        if(NOT memory_type STREQUAL "NULL")
            message(FATAL_ERROR "Unsupported platform must report null memory")
        endif()
    else()
        string(JSON peak GET "${output}" memory peak_resident_bytes)
        if(NOT memory_type STREQUAL "NUMBER" OR NOT peak MATCHES "^[0-9]+$" OR peak LESS_EQUAL 0)
            message(FATAL_ERROR "Expected a positive byte-valued process peak: ${output}")
        endif()
    endif()
endfunction()

foreach(scenario IN ITEMS match cancel sweep)
    check_sample(${scenario} 3)
    check_sample(${scenario} 3 --book --record)
    check_sample(${scenario} 3 --instruments 16 --skewed --record)
endforeach()
